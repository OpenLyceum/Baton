{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repos.schema.json",
  "title": "Repository catalog",
  "description": "Machine-readable catalog of the organization's repositories. Consumed by bootstrap, fleet scripts, Pages, and compliance tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "organization", "pagesBase", "repos"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema file (relative or absolute)."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Catalog schema semver. Bump when field semantics change."
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "description": "GitHub organization login. The single source of truth for the org name across all fleet tooling."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable organization name for page titles and headings (e.g. \"Open Lyceum\"). Defaults to organization when absent."
    },
    "pagesBase": {
      "type": "string",
      "pattern": "^https://[^/]+$",
      "description": "Base URL for GitHub Pages sites, no trailing slash (e.g. https://<org>.github.io). Every deployedUrl is derived from this."
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repo" }
    }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "type",
        "isSimulation",
        "lineage",
        "upstream",
        "language",
        "framework",
        "description",
        "physicsTopics",
        "screens",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub repository name (and sibling workspace folder)."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable title for landing-page cards and docs."
        },
        "type": {
          "type": "string",
          "enum": ["simulation", "template", "tool", "config", "hardware-interface"]
        },
        "isSimulation": {
          "type": "boolean",
          "description": "Convenience filter; must equal (type == \"simulation\")."
        },
        "lineage": {
          "description": "Landing-page bucket for simulations; null for non-simulations.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": ["original", "phet", "naap"]
            }
          ]
        },
        "subject": {
          "description": "Discipline the simulation is filed under on the Pages landing page (filter chips and the default grouping); null for non-simulations. Omitted is treated as null.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": ["physics", "chemistry", "astronomy", "earth-science"]
            }
          ]
        },
        "upstream": {
          "description": "Provenance for ports; null when lineage is original or the repo is not a simulation.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/upstream" }
          ]
        },
        "language": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "framework": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": ["SceneryStack", "VitePress", "GlowScript"]
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Full blurb for the Pages landing-page card (and docs)."
        },
        "shortDescription": {
          "description": "Optional GitHub About blurb (≤350 chars). When omitted, sync-github-metadata uses description (truncated if needed).",
          "type": "string",
          "minLength": 1,
          "maxLength": 350
        },
        "deployedUrl": {
          "description": "Pages URL override. Omit to derive <pagesBase>/<name>; null means the repo is not deployed.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^https://"
            }
          ]
        },
        "physicsTopics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Physics / domain topics. First three appear on the Pages card; all are slugified into GitHub topics for simulations."
        },
        "githubTopics": {
          "type": "array",
          "description": "Extra GitHub topics beyond the base set (physics, scenerystack, simulation) and slugified physicsTopics. Kebab-case only.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "screens": {
          "description": "Simulation screens as {id, title}; null for non-simulations. id is kebab-case (usually src/<id>/).",
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/screen" }
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": ["active", "template", "draft", "wip", "archived"],
          "description": "active = Pages + fleet-health; draft/wip = in catalog but not shipped; archived = retained history; template = seed repo."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "simulation" } } },
          "then": {
            "required": ["subject"],
            "properties": {
              "isSimulation": { "const": true },
              "subject": { "type": "string", "enum": ["physics", "chemistry", "astronomy", "earth-science"] },
              "lineage": { "type": "string", "enum": ["original", "phet", "naap"] },
              "physicsTopics": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "screens": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/screen" }
              }
            }
          },
          "else": {
            "properties": {
              "isSimulation": { "const": false },
              "lineage": { "type": "null" },
              "upstream": { "type": "null" },
              "screens": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "lineage": { "enum": ["phet", "naap"] } }
          },
          "then": {
            "properties": {
              "upstream": { "$ref": "#/$defs/upstream" }
            }
          },
          "else": {
            "properties": {
              "upstream": { "type": "null" }
            }
          }
        }
      ]
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Kebab-case screen key. Usually the package directory under src/; for multi-screen packages (e.g. MovingMan) the Screen-class stem (IntroScreen → intro)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable screen title shown in the sim UI / catalog."
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["org", "name", "url"],
      "properties": {
        "org": {
          "type": "string",
          "enum": ["phet", "naap"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Upstream simulation / lab title."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Canonical upstream page URL."
        }
      }
    }
  }
}
