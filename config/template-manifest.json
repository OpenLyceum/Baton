{
  "$comment": "Template-owned files and package.json surface for SceneryStack sims. Read by scripts/check-template-drift.mjs. The template repo is the source of content; this file only says WHAT must match and HOW. A sim approves a deviation by naming the path (or script) in backticks under its AGENTS.md '## Compliance carve-outs' section.",
  "template": "SceneryStackTemplate",
  "tokens": {
    "packageName": "scenerystack-template",
    "repoName": "SceneryStackTemplate"
  },
  "exact": [
    ".gitattributes",
    ".githooks/pre-commit",
    ".githooks/pre-push",
    ".github/CODEOWNERS",
    ".github/dependabot.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/deploy.yml",
    ".claude/settings.json",
    "SECURITY.md",
    "tsconfig.scripts.json",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.soak.config.ts",
    "playwright.config.ts",
    "scripts/generate-icons.ts",
    "scripts/pwa-config.ts",
    "scripts/test-fuzz.ts",
    "tests/setup.ts",
    "tests/fuzz/fuzz.spec.ts",
    "tests/helpers/memoryLeak.ts",
    "tests/helpers/headlessSoak.ts",
    "tests/soak/browser.spec.ts",
    "src/assert.ts",
    "src/brand.ts",
    "src/splash.ts",
    "biome-plugins/no-native-tofixed.grit",
    "biome-plugins/no-math-random.grit",
    "biome-plugins/no-math-round.grit",
    "biome-plugins/no-native-timer.grit",
    "biome-plugins/no-window-inner-size.grit",
    "biome-plugins/require-property-suffix.grit",
    "biome-plugins/no-hardcoded-text.grit",
    "biome-plugins/no-inline-color.grit",
    "tests/biome-plugins.node-test.ts"
  ],
  "architecture": {
    "files": [".dependency-cruiser.cjs", "tests/architecture.node-test.ts"],
    "scripts": ["check:architecture", "test:architecture"]
  },
  "ownedIfPresent": [
    "src/common/TimeModel.ts"
  ],
  "linesSuperset": [
    ".gitignore"
  ],
  "jsonExtend": {
    "tsconfig.json": [
      "compilerOptions.types",
      "compilerOptions.lib"
    ],
    "tsconfig.test.json": [
      "compilerOptions.types"
    ],
    "biome.json": [
      "files.includes",
      "overrides"
    ],
    "knip.json": [
      "entry",
      "project",
      "ignoreFiles",
      "ignoreDependencies",
      "ignoreUnresolved",
      "ignoreBinaries"
    ]
  },
  "templateOnly": {
    "jsonArrayValues": {
      "knip.json": {
        "entry": [
          "src/common/SimControlOptions.ts!",
          "src/common/SimPanel.ts!",
          "src/common/TimeModel.ts!"
        ]
      }
    },
    "files": [
      "scripts/rename-sim.ts",
      "scripts/scaffold-screens.ts",
      "tests/generators.test.ts",
      "tests/fuzz-runner.test.ts",
      "doc/multi-screen.md",
      "doc/improvement-recommendations.md"
    ],
    "scripts": [
      "rename",
      "scaffold-screens"
    ]
  },
  "forbidden": [
    "tests/browser/memory-soak.spec.ts",
    ".fuzz-playwright.config.ts",
    "CLAUDE.md",
    ".cursor",
    ".vscode/settings.json",
    ".eslintrc",
    ".eslintrc.json",
    ".eslintrc.cjs",
    "eslint.config.js",
    "eslint.config.mjs",
    ".prettierrc",
    ".prettierrc.json"
  ],
  "noTemplateCopies": {
    "$comment": "Docs that must be sim-specific: a copy sharing at least `threshold` of its non-blank lines with the template's file is flagged.",
    "threshold": 0.6,
    "files": [
      "doc/model.md",
      "doc/implementation-notes.md",
      "doc/multi-screen.md",
      "doc/improvement-recommendations.md"
    ]
  },
  "packageJson": {
    "requiredScriptsFromTemplate": true,
    "requiredDependenciesFromTemplate": true,
    "matchDirectDependencyLockVersions": true,
    "matchKeys": [
      "type",
      "private",
      "license",
      "engines",
      "devEngines"
    ],
    "overridesSuperset": true
  }
}
