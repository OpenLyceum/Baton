{
  "name": "openlyceum-org-scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tooling for the OpenLyceum org orchestration repo (Baton): repo metadata helpers, simulation screenshot capture, and the Pages landing page.",
  "scripts": {
    "screenshots": "bash scripts/generate-screenshots.sh",
    "thumbnails": "node scripts/make-thumbnails.mjs",
    "pages": "bash scripts/generate-pages-index.sh",
    "refresh": "bash scripts/refresh-screenshots.sh"
  },
  "devDependencies": {
    "bats": "^1.13.0",
    "bats-assert": "^2.2.4",
    "bats-support": "^0.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
